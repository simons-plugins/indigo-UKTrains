# Darwin LDBWS REST API Configuration
# Free key: subscribe to "Live Departure Board Web Service (LDBWS) - Public"
# at https://raildata.org.uk/

# Your LDBWS consumer key (required for live tests)
DARWIN_API_KEY=your_consumer_key_here

